# Copy to .env and fill in only the keys you use. Never commit .env.
# ./scripts/check-setup.sh checks which keys are set (it never prints values).

# Models
ANTHROPIC_API_KEY=
ARCEE_API_KEY=            # platform.arcee.ai (OpenAI-compatible, base https://api.arcee.ai/api/v1)

# Senso (keys start tgr_) - REST https://apiv2.senso.ai/api/v1, header X-API-Key
SENSO_API_KEY=

# Firedrill - app.firedrill.run, event code TOKENSAND
FIREDRILL_API_KEY=

# Guild AI
GUILD_API_KEY=

# Cognee (uses this for its LLM calls)
LLM_API_KEY=

# Superlinked SIE (keys start sk-sie-), base https://api.superlinked.com
SIE_API_KEY=

# SingleStore connection URL
SINGLESTORE_URL=

# Amplitude / Statsig (optional)
AMPLITUDE_API_KEY=
STATSIG_SERVER_SECRET=

# Demo delivery ZIP (keep the real value only in .env)
DEMO_ZIP=
